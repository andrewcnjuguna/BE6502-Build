%SIGNAL
PIN   6 =  A10 
PIN   5 =  A11 
PIN   4 =  A12 
PIN   3 =  A13 
PIN   2 =  A14 
PIN   1 =  A15 
PIN  14 = !ACIACS 
PIN  15 = !LCDCS 
PIN  13 = !ROMCE 
PIN  12 = !SIDCS 
%END

%FIELD
%END

%EQUATION
ACIACS =>
    !A10 & !A11 & A12 & !A13 & A14 & !A15

LCDCS =>
    A10 & A11 & !A12 & !A13 & A14 & !A15

ROMCE =>
    !A14 & A15
  # A13 & A15
  # !A12 & A15
  # A11 & A15
  # !A10 & A15

SIDCS =>
    A10 & !A11 & A12 & !A13 & A14 & A15
  # !A10 & A11 & !A12 & !A13 & A14 & !A15

%END
