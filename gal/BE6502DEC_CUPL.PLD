Name       BE6502DEC ;
PartNo     01 ;
Date       2026-08-30 ;
Revision   02 ;
Designer   andrewcnjuguna ;
Company    BE6502 ;
Assembly   None ;
Location   U1 ;
Device     g16v8 ;

/* =====================================================================
   Ben Eater 6502 address decoder - replaces both 74HC138s and the
   74HC00. Purely combinatorial.

     $4800-$4BFF  SID / SIDKick pico   (kept, existing software works)
     $4C00-$4FFF  LCD latch (74LS574)
     $5000-$53FF  W65C51 ACIA
     $5400-$57FF  FM select, to the SKpico's A8/IO pad (rev 02)
     $D400-$D7FF  SID again at the native C64 address
     ROM enabled for $8000-$FFFF EXCEPT the $D400 kilobyte

   Outputs are declared as !NAME so the physical pin goes LOW when the
   equation below is true - i.e. active-low chip selects.

   This is the CUPL version, for WinCUPL. BE6502DEC.pld beside it is the
   same logic in galasm syntax; the two are NOT interchangeable.
   ===================================================================== */

/* ---------------- inputs ---------------- */
PIN 1  = A15 ;
PIN 2  = A14 ;
PIN 3  = A13 ;
PIN 4  = A12 ;
PIN 5  = A11 ;
PIN 6  = A10 ;
PIN 7  = PHI2 ;
PIN 8  = RW ;         /* 6502 R/W: high = read, low = write */

/* ---------------- outputs, all active low ---------------- */
PIN 12 = !SIDCS ;
PIN 13 = !ROMCE ;
PIN 14 = !ACIACS ;
PIN 15 = !LCDWR ;
PIN 16 = !FMSEL ;

/* $D400 = 1101 0100 ....    $4800 = 0100 1000 .... */
SIDCS  = ( A15 &  A14 & !A13 &  A12 & !A11 &  A10)
       # (!A15 &  A14 & !A13 & !A12 &  A11 & !A10) ;

/* $5400 = 0101 01.. ....  to the SKpico's A8/IO pad. With SID #2 set to
   FM at the IO address (config byte 8 = 4, byte 10 = 5) the SKpico takes
   the pad low with its /CS high as an OPL2 access. Its A5 pad - wired to
   CPU A5 for the $D420 second SID - must be high and A0-A3 low; A4 picks
   the port: $5420 OPL2 address, $5430 OPL2 data. Address-only. */
FMSEL  = !A15 &  A14 & !A13 &  A12 & !A11 &  A10 ;

/* $4C00 = 0100 1100 ....  qualified with PHI2 and WRITE.
   The 74LS574 clocks on a RISING edge, so this must go low during the
   access and rise at the end of it. Address decode alone will not do:
   the address bus is only guaranteed valid while PHI2 is high, and a
   transient through this 1K window between cycles would clock garbage
   into the latch. The latch is the only device here needing an edge. */
LCDWR  = !A15 &  A14 & !A13 & !A12 &  A11 &  A10 &  PHI2 & !RW ;

/* $5000 = 0101 0000 .... */
ACIACS = !A15 &  A14 & !A13 &  A12 & !A11 & !A10 ;

/* ROM on for A15=1, off across $D400-$D7FF. De Morgan on the
   exclusion: !(A14 & !A13 & A12 & !A11 & A10)
            =  !A14 # A13 # !A12 # A11 # !A10                      */
ROMCE  = (A15 & !A14)
       # (A15 &  A13)
       # (A15 & !A12)
       # (A15 &  A11)
       # (A15 & !A10) ;
