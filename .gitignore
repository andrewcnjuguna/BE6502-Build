# assembler / toolchain binaries - do not vendor these
*.exe
*.dll

# assembler byproducts
Listing.txt
*.sym
*.lst

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# python bytecode
__pycache__/
*.pyc

