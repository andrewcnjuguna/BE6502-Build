# assembler / toolchain binaries - do not vendor these
*.exe
*.dll

# assembler byproducts
Listing.txt
*.sym
*.lst

# OS junk
Thumbs.db
desktop.ini
.DS_Store

# python bytecode
__pycache__/
*.pyc

# Doom builds carry Doom's own data - doomplay.py output, never committed
DoomPlay_*.bin
DoomPlay_*.asm
DoomPlay_*.sym
DoomPlay_*_data.a
*.WAD
*.wad

# HVSC index cache and fetch output
Songlengths.md5
hvsc_out/

# WinCUPL byproducts - the .jed is the deliverable
*.abs
*.sim
*.doc
*.lst

# sidreloc build output - the source in code/sidreloc/ is vendored, the binary is not
code/sidreloc/*.o
code/sidreloc/sidreloc
