# Copy to .env (same folder) and fill in. .env is gitignored.
# Real environment variables take precedence over this file.

# --- Telegram -------------------------------------------------------------------
# A NEW bot from @BotFather - not the flash agent's. Two processes polling
# one token steal each other's messages (the bot logs "409 Conflict").
# Chat id: message the bot once, then open
#   https://api.telegram.org/bot<token>/getUpdates  and read message.chat.id
# Only that chat can drive the agent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Seconds an Approve/Decline prompt waits before counting as declined
#BE6502_AGENT_APPROVAL_TIMEOUT_S=600

# --- Local model ------------------------------------------------------------------
# The Mac running ~/code/local-llm/serve.sh, started with HOST=0.0.0.0
LOCAL_LLM_URL=http://192.168.0.152:8080/v1
#LOCAL_LLM_MODEL=lmstudio-community/Qwen3.8-27B-MLX-6bit
#LOCAL_LLM_THINKING=0
#LOCAL_LLM_TIMEOUT_S=900

# --- The BE6502 ------------------------------------------------------------------
# Leave empty to use the one USB serial adapter plugged in (/dev/ttyUSB0)
#BE6502_PORT=/dev/ttyUSB0
# Tune folders, ':'-separated, searched recursively
BE6502_TUNES=/home/andrew/BE6502_SidPlayer
